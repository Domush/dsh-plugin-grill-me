{
  "name": "dsh-plugin-grill-me",
  "version": "1.0.2",
  "description": "Structured planning and requirement gathering command for DeepSeek Harness mimicking the Antigravity /grill-me workflow",
  "type": "module",
  "license": "MIT",
  "author": "Phillip Webber <github@webbsense.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Domush/dsh-plugin-grill-me.git"
  },
  "bugs": {
    "url": "https://github.com/Domush/dsh-plugin-grill-me/issues"
  },
  "homepage": "https://github.com/Domush/dsh-plugin-grill-me#readme",
  "keywords": [
    "deepseek-harness",
